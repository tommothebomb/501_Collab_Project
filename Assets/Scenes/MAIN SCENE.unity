  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuoteScript
  namesText: {fileID: 285000898}
  quotes:
  - '"He who goes to sleep with an itchy bottom wakes up with smelly fingers."'
  - '"I got a hand in my hand sandwiched in my hands."'
  - '"When she Pepsi on my max til I lower my sperm count."'
  - '"Wake up Samurai, we''ve got Jimmys to Saville."'
  - '"My vape is dead."'
  - '"The thing about Arsenal is they always try to walk it in"'
  - '"Hola."'
  - '"She a sine wave the way she go up and down."'
  - '"I''m not good at handling stiff things."'
  - '"Yaoi. Light of my life, fire of my loins."'
  names:
  - '- Callum Green'
  - '- Jordan Hughes'
  - '- Thomas M Sollars'
  - '- Harrison Hunt'
  - '- Josh Aitouret'
  - '- Dan Bailey'
  - '- Abel'
  - '- Abi Skierka'
  - '- Tomi Sollars'
  - '- Callum Green'
