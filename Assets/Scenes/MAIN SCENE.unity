MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1888205156}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ab6fd1353d08de4e9b6f2164e38ce35, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextMessageManager
  messageNotification: {fileID: 526806499}
  replaceableText: {fileID: 898675422}
  replaceableNameText: {fileID: 1146903256}
  messages:
  - How did you live so long? Don't worry, the company will be in good hands...
  - Hiii, you still here? I couldn't help myself and went shopping, so I'll need
    that money soon xoxo
  - I was thinking of you today and also thinking of that vacation your estate is
    funding.
  - I always knew family was more important than money. That's why I married into
    a rich one.
  - Everyone is soft from your leadership and weakness, but I will cure this place.
  names:
  - Dylan (Grandson)
  - Diamond (Granddaughter)
  - Stan (Son)
  - Karen (Daughter-in-law)
  - Burt (Grandson)
